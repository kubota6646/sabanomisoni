FLASK_APP=app.py
SECRET_KEY=change-this-secret-key
# DATABASE_URL を省略すると SQLite（saba_miso.db）を自動的に使用します。
# MySQL を使う場合は以下のコメントを外して接続情報を設定してください。
# DATABASE_URL=mysql+pymysql://username:password@localhost/saba_miso
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
WTF_CSRF_SECRET_KEY=change-this-csrf-secret
TRUST_PROXY_HEADERS=false
HTTPS_ENABLED=false
ADMIN_SESSION_HOURS=2
